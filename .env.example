# BLEXware environment template.
# Copy to .env.local (or .env.development / .env.test) and fill in values.
# NEVER commit real values — this file documents required variables only.
#
# This app is TanStack Start + Vite: variables exposed to the browser MUST be
# prefixed VITE_. Everything else is server-only.
#
# Environments:
#   local        -> .env.local
#   test         -> .env.test
#   development  -> .env.development
#   staging      -> deployment environment secrets
#   production   -> hosting platform secret manager

# --- environment (src/config/environment.ts) ---
APP_ENV=development
VITE_APP_URL=

# --- database / Supabase (src/config/database.ts) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Server-side equivalents (used during SSR and by server functions)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- payments / Hyperswitch (src/config/payments.ts) ---
PAYMENTS_PROVIDER=hyperswitch
HYPERSWITCH_ENVIRONMENT=sandbox
HYPERSWITCH_API_URL=
HYPERSWITCH_API_KEY=
VITE_HYPERSWITCH_PUBLISHABLE_KEY=
HYPERSWITCH_PROFILE_ID=
HYPERSWITCH_WEBHOOK_SECRET=

# --- AI (src/config/ai.ts) ---
# Primary: Gemini AI Studio. Backup: Groq (used automatically on Gemini 429/5xx/quota).
# Inside Lovable, LOVABLE_API_KEY is still injected if these are unset.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Legacy single-provider override (unused when GEMINI_API_KEY or GROQ_API_KEY is set)
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# --- email (src/config/email.ts) ---
EMAIL_PROVIDER=zeptomail
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=quote@blexware.com
EMAIL_FROM_NAME=BLEXware
EMAIL_REPLY_TO=hello@blexware.com
EMAIL_BOUNCE_ADDRESS=

# --- storage (src/config/storage.ts) ---
STORAGE_BUCKET_QUOTES=quote-uploads
STORAGE_BUCKET_DOCUMENTS=documents

# --- scheduled work & auth hooks ---
CRON_SECRET=
AUTH_HOOK_SECRET=

# --- test harness only (not read by app code) ---
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
